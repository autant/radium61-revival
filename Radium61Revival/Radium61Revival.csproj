<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Radium61Revival</AssemblyName>
    <RootNamespace>Radium61Revival</RootNamespace>
    <Product>Radium61 Revival</Product>
    <Version>5.0.0</Version>
    <FileVersion>5.0.0.0</FileVersion>
    <Description>USB WinUSB to Windows MIDI bridge for M-Audio Radium 61</Description>
    <ApplicationIcon>radium.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="radium.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
